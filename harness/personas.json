      "sources": { "moved": ["ohealth-steps", "ohealth-walk"], "strength": ["watch-drill", "manual"], "mobility": ["manual"], "meal": ["manual"], "hydration": ["watch-quick"], "rest": ["manual"] }
    },
    {
